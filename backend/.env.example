PORT=4000

# Local Postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/agenthub"

# Monad Testnet
MONAD_RPC_URL=https://rpc.monad.xyz
MONAD_WS_URL=wss://rpc.monad.xyz

# nad.fun WebSocket stream (check nad.fun docs for latest)
NADFUN_WS_URL=wss://api-server.nad.fun/wss

# Master encryption key for agent wallets (exactly 32 chars)
WALLET_ENCRYPTION_KEY=change_this_to_a_32_char_secret!!

# CryptoPanic API (optional)
CRYPTOPANIC_API_KEY=your_cryptopanic_key
